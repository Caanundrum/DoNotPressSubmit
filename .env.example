# DO NOT PRESS SUBMIT — environment

# Phase 4 live AI (optional). Without a key the game still runs:
# local mock flavor seasons dialogue; authored lines always remain the fallback.
OPENAI_API_KEY=

# Optional overrides
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# auto (default) | mock | live
# auto → live when OPENAI_API_KEY is set, otherwise local mock
# mock → always local mock (good for offline QA)
# live → prefer OpenAI; degrades to mock if the key/call fails
# DNPS_AI_MODE=auto
